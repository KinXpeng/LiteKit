{
  "name": "litekit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "轻序 LiteKit — 手工维护的好工具链接导航站",
  "scripts": {
    "dev": "node scripts/check-node.mjs && vite",
    "start": "node scripts/check-node.mjs && vite",
    "build": "node scripts/check-node.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "antd": "^5.21.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
